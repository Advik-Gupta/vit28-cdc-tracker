# Copy this file to .env.local and fill in the values.

# --- Google (Gmail read access) ---
# How to get these two values (about 5 minutes, free):
#  1. Create a project (any name; a personal Gmail account is fine):
#       https://console.cloud.google.com/projectcreate
#  2. Enable the Gmail API for that project:
#       https://console.cloud.google.com/apis/library/gmail.googleapis.com
#  3. Set up the consent screen: click "Get started", give any app name,
#     pick your email as support email, choose audience "External", finish:
#       https://console.cloud.google.com/auth/overview
#  4. Under "Test users" click "Add users" and add your VIT email address
#     (the account that receives the CDC mails):
#       https://console.cloud.google.com/auth/audience
#  5. Click "Create client". Application type: "Web application".
#     Under "Authorized redirect URIs" add exactly:
#       http://localhost:3000/api/auth/google/callback
#       https://console.cloud.google.com/auth/clients
#  6. Copy the Client ID and Client secret shown after creating it into the
#     two lines below, run the app locally (npm run dev) and open
#     http://localhost:3000/api/auth/google once to connect your Gmail.
#  IMPORTANT: while the consent screen is in "Testing", Google cancels the
#  connection after 7 days and the daily job stops. Press "Publish app" on the
#  Audience page, then connect Gmail again (step 6). The "unverified app"
#  warning you see when connecting is expected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (Supabase) ---
# Supabase dashboard -> your project -> Connect -> "Transaction pooler" -> copy the URI and
# replace [YOUR-PASSWORD] with the database password. Looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Left empty, the app uses a throwaway database in data/pg so it still runs on your machine.
DATABASE_URL=

# --- Daily job ---
# Any long random string. Vercel sends it when it runs the 12 pm job, so nobody else can trigger one.
CRON_SECRET=

# --- Groq (optional) ---
# Mails are read by built-in rules, which need no key. If a Groq key is set, mails
# the rules cannot make sense of get a second reading by a language model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional ---
# Which mails count as placement-cell mails (Gmail search syntax).
GMAIL_QUERY=from:("No Reply CDC Info" OR "Helpdesk CDC")
# Only fetch mails after this date (YYYY/MM/DD). Leave empty to fetch everything.
GMAIL_AFTER=2026/07/01
# Only used for the one-time "connect Gmail" step, which is done on your own machine.
APP_URL=http://localhost:3000
